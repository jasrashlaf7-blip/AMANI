<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>For Amani — From Jasser</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-deep: #140814;
      --bg-plum: #240c24;
      --rose-gold: #e8b4b8;
      --rose-bright: #ffd1d6;
      --gold-accent: #f3d299;
      --glass-bg: rgba(42, 16, 40, 0.55);
      --glass-border: rgba(232, 180, 184, 0.25);
      --text-main: #fdf6f7;
      --text-muted: #d4b8be;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: radial-gradient(circle at top center, #2d0f2b 0%, var(--bg-deep) 65%, #0c040c 100%);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
      min-height: 100vh;
      line-height: 1.6;
    }

    h1, h2, h3, .serif {
      font-family: 'Cormorant Garamond', serif;
    }

    /* Background Canvas for Stars & Petals */
    #ambientCanvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }

    /* Floating Music Box Controller */
    .music-pill {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 100;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 18px;
      background: rgba(30, 11, 29, 0.78);
      backdrop-filter: blur(14px);
      border: 1px solid var(--glass-border);
      border-radius: 999px;
      color: var(--rose-bright);
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.45);
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .music-pill:hover {
      transform: translateY(-2px);
      border-color: var(--rose-gold);
    }

    .equalizer {
      display: flex;
      align-items: flex-end;
      gap: 3px;
      height: 14px;
    }

    .equalizer span {
      width: 3px;
      height: 4px;
      background: var(--gold-accent);
      border-radius: 2px;
      transition: height 0.2s ease;
    }

    .music-pill.playing .equalizer span {
      animation: eqBounce 0.9s infinite ease-in-out alternate;
    }
    .music-pill.playing .equalizer span:nth-child(2) { animation-delay: 0.2s; }
    .music-pill.playing .equalizer span:nth-child(3) { animation-delay: 0.4s; }
    .music-pill.playing .equalizer span:nth-child(4) { animation-delay: 0.15s; }

    @keyframes eqBounce {
      0% { height: 4px; }
      100% { height: 14px; }
    }

    /* Main Layout */
    main {
      position: relative;
      z-index: 2;
      max-width: 980px;
      margin: 0 auto;
      padding: 0 22px 100px;
    }

    section {
      padding: 85px 0;
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.85s ease, transform 0.85s ease;
    }

    section.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .chapter-tag {
      display: inline-block;
      font-size: 0.75rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--gold-accent);
      margin-bottom: 10px;
    }

    .section-title {
      font-size: clamp(2.1rem, 4.5vw, 3.2rem);
      font-weight: 600;
      line-height: 1.15;
      background: linear-gradient(135deg, #fff 15%, var(--rose-gold) 60%, var(--gold-accent) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 14px;
    }

    .section-sub {
      color: var(--text-muted);
      max-width: 580px;
      margin: 0 auto 42px;
      font-size: 1rem;
    }

    .center {
      text-align: center;
    }

    /* CHAPTER 1: HERO COVER */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding-top: 40px;
    }

    .heart-seal {
      width: 112px;
      height: 112px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, rgba(232, 180, 184, 0.3), rgba(42, 16, 40, 0.85));
      border: 1px solid rgba(243, 210, 153, 0.45);
      display: grid;
      place-items: center;
      margin-bottom: 28px;
      cursor: pointer;
      position: relative;
      box-shadow: 0 0 40px rgba(232, 180, 184, 0.25);
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
    }

    .heart-seal:hover {
      transform: scale(1.08);
      box-shadow: 0 0 55px rgba(232, 180, 184, 0.45);
    }

    .heart-seal svg {
      width: 48px;
      height: 48px;
      fill: var(--rose-gold);
      filter: drop-shadow(0 0 10px rgba(232, 180, 184, 0.6));
      animation: heartbeat 2.2s infinite ease-in-out;
    }

    @keyframes heartbeat {
      0%, 100% { transform: scale(1); }
      15% { transform: scale(1.14); }
      30% { transform: scale(1); }
      45% { transform: scale(1.09); }
    }

    .hero h1 {
      font-size: clamp(2.8rem, 7vw, 5rem);
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.08;
      background: linear-gradient(120deg, #ffffff 10%, var(--rose-bright) 48%, var(--gold-accent) 85%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 18px;
    }

    .hero p {
      font-size: 1.12rem;
      color: var(--text-muted);
      max-width: 540px;
      margin-bottom: 34px;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--rose-gold), var(--gold-accent));
      color: #1c081a;
      border: none;
      padding: 14px 32px;
      border-radius: 999px;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      box-shadow: 0 10px 30px rgba(232, 180, 184, 0.3);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 36px rgba(232, 180, 184, 0.48);
    }

    /* CHAPTER 2: 3D FLIP ADORATION CARDS */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 24px;
    }

    .flip-card {
      height: 290px;
      perspective: 1100px;
      cursor: pointer;
    }

    .flip-inner {
      position: relative;
      width: 100%;
      height: 100%;
      transition: transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
      transform-style: preserve-3d;
    }

    .flip-card.flipped .flip-inner {
      transform: rotateY(180deg);
    }

    .flip-front, .flip-back {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      border-radius: 22px;
      padding: 28px;
      background: var(--glass-bg);
      backdrop-filter: blur(14px);
      border: 1px solid var(--glass-border);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
    }

    .flip-front .card-num {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.4rem;
      color: var(--gold-accent);
      margin-bottom: 10px;
    }

    .flip-front h3 {
      font-size: 1.55rem;
      color: var(--rose-bright);
      margin-bottom: 8px;
    }

    .flip-front span {
      font-size: 0.8rem;
      color: var(--text-muted);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .flip-back {
      transform: rotateY(180deg);
      background: linear-gradient(155deg, rgba(64, 21, 58, 0.85), rgba(29, 10, 28, 0.92));
      border-color: rgba(243, 210, 153, 0.45);
    }

    .flip-back p {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.38rem;
      font-style: italic;
      color: #fff;
      line-height: 1.45;
    }

    /* CHAPTER 3: COMPLIMENT & RIZZ GENERATOR */
    .glass-box {
      background: var(--glass-bg);
      backdrop-filter: blur(16px);
      border: 1px solid var(--glass-border);
      border-radius: 26px;
      padding: 42px 30px;
      text-align: center;
      max-width: 720px;
      margin: 0 auto;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    }

    .rizz-display {
      min-height: 110px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.5rem, 3.2vw, 2.05rem);
      font-style: italic;
      color: var(--rose-bright);
      margin-bottom: 28px;
      padding: 0 12px;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .btn-outline {
      background: transparent;
      color: var(--rose-bright);
      border: 1px solid var(--rose-gold);
      padding: 12px 28px;
      border-radius: 999px;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 500;
      font-size: 0.92rem;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .btn-outline:hover {
      background: rgba(232, 180, 184, 0.16);
      transform: translateY(-2px);
    }

    /* CHAPTER 4: CONSTELLATION FRAME & LOVE COUPONS */
    .constellation-wrap {
      position: relative;
      border-radius: 24px;
      border: 1px solid rgba(243, 210, 153, 0.32);
      background: radial-gradient(circle at center, rgba(58, 19, 54, 0.5), rgba(18, 6, 18, 0.85));
      padding: 36px 24px;
      margin-bottom: 32px;
      overflow: hidden;
    }

    .constellation-svg {
      width: 100%;
      max-width: 520px;
      height: 150px;
      margin: 0 auto 12px;
      display: block;
    }

    .coupons-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      margin-top: 24px;
    }

    .coupon {
      background: rgba(34, 12, 33, 0.75);
      border: 1px dashed rgba(243, 210, 153, 0.5);
      border-radius: 18px;
      padding: 22px 18px;
      text-align: center;
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .coupon:hover {
      transform: translateY(-3px);
      border-color: var(--gold-accent);
    }

    .coupon h4 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.4rem;
      color: var(--gold-accent);
      margin-bottom: 6px;
    }

    .coupon p {
      font-size: 0.86rem;
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .coupon button {
      background: rgba(232, 180, 184, 0.15);
      border: 1px solid var(--rose-gold);
      color: var(--rose-bright);
      padding: 7px 18px;
      border-radius: 999px;
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .coupon.claimed {
      opacity: 0.65;
      border-style: solid;
    }

    .coupon.claimed button {
      background: var(--gold-accent);
      color: #1c081a;
      border-color: var(--gold-accent);
      font-weight: 600;
      cursor: default;
    }

    /* CHAPTER 5: FINALE */
    .finale-box {
      text-align: center;
      padding: 54px 28px;
      border-radius: 28px;
      background: linear-gradient(160deg, rgba(58, 19, 54, 0.65), rgba(22, 8, 22, 0.85));
      border: 1px solid rgba(232, 180, 184, 0.32);
    }

    .love-counter {
      margin-top: 18px;
      font-size: 0.92rem;
      color: var(--gold-accent);
      min-height: 24px;
    }

    footer {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.85rem;
      padding-top: 30px;
      opacity: 0.75;
    }
  </style>
</head>
<body>

  <canvas id="ambientCanvas"></canvas>

  <!-- Music Box Toggle -->
  <button class="music-pill" id="musicToggle" aria-label="Toggle romantic music">
    <div class="equalizer">
      <span></span><span></span><span></span><span></span>
    </div>
    <span id="musicLabel">Play Music Box</span>
  </button>

  <main>
    <!-- CHAPTER 1: COVER -->
    <section class="hero visible" id="chapter1">
      <div class="heart-seal" id="heroHeart" title="Tap to open with music">
        <svg viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </div>
      <span class="chapter-tag">Chapter I &bull; A Digital Keepsake</span>
      <h1>For Amani, With Love</h1>
      <p>Every star in this midnight sky was placed here to remind you how effortlessly you light up my world. Crafted just for you by Jasser.</p>
      <button class="btn-primary" id="startJourneyBtn">Begin Your Story &darr;</button>
    </section>

    <!-- CHAPTER 2: 3D FLIP ADORATION CARDS -->
    <section id="chapter2">
      <div class="center">
        <span class="chapter-tag">Chapter II &bull; Little Truths</span>
        <h2 class="section-title">Reasons I Adore You</h2>
        <p class="section-sub">Tap each card to flip it over and read what my heart never gets tired of saying.</p>
      </div>

      <div class="cards-grid">
        <div class="flip-card" onclick="this.classList.toggle('flipped')">
          <div class="flip-inner">
            <div class="flip-front">
              <div class="card-num">01</div>
              <h3>Your Presence</h3>
              <span>Tap to reveal</span>
            </div>
            <div class="flip-back">
              <p>“The second you walk into a room—or pop up on my screen—everything noisy in the world suddenly feels calm and right.”</p>
            </div>
          </div>
        </div>

        <div class="flip-card" onclick="this.classList.toggle('flipped')">
          <div class="flip-inner">
            <div class="flip-front">
              <div class="card-num">02</div>
              <h3>Your Smile</h3>
              <span>Tap to reveal</span>
            </div>
            <div class="flip-back">
              <p>“If I could bottle up the warmth of your laugh and the spark in your eyes, I’d never have a dark day again.”</p>
            </div>
          </div>
        </div>

        <div class="flip-card" onclick="this.classList.toggle('flipped')">
          <div class="flip-inner">
            <div class="flip-front">
              <div class="card-num">03</div>
              <h3>Your Heart</h3>
              <span>Tap to reveal</span>
            </div>
            <div class="flip-back">
              <p>“You care with a rare kind of grace and kindness that makes me want to be the best version of myself every single day.”</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CHAPTER 3: COMPLIMENT & RIZZ GENERATOR -->
    <section id="chapter3">
      <div class="center">
        <span class="chapter-tag">Chapter III &bull; On Demand</span>
        <h2 class="section-title">Whenever You Need a Reminder</h2>
        <p class="section-sub">Press the button whenever you want to know exactly what Jasser is thinking about you.</p>
      </div>

      <div class="glass-box">
        <div class="rizz-display" id="rizzText">
          “Out of every timeline and every universe, finding you is still my favorite plot twist.”
        </div>
        <button class="btn-outline" id="newRizzBtn">Draw Another Note &spades;</button>
      </div>
    </section>

    <!-- CHAPTER 4: CONSTELLATION & LOVE COUPONS -->
    <section id="chapter4">
      <div class="center">
        <span class="chapter-tag">Chapter IV &bull; Written in the Stars</span>
        <h2 class="section-title">Our Constellation &amp; Vouchers</h2>
        <p class="section-sub">Redeemable anytime, with zero expiration date and unlimited hugs included.</p>
      </div>

      <div class="constellation-wrap center">
        <svg class="constellation-svg" viewBox="0 0 500 140">
          <g stroke="rgba(243, 210, 153, 0.45)" stroke-width="1.3" fill="none">
            <polyline points="50,105 120,45 200,85 280,30 365,75 445,35" />
            <line x1="200" y1="85" x2="250" y2="120" />
            <line x1="250" y1="120" x2="365" y2="75" />
          </g>
          <g fill="#ffd1d6">
            <circle cx="50" cy="105" r="4" />
            <circle cx="120" cy="45" r="5" />
            <circle cx="200" cy="85" r="4.5" />
            <circle cx="280" cy="30" r="6" fill="#f3d299" />
            <circle cx="365" cy="75" r="4.5" />
            <circle cx="445" cy="35" r="5" />
            <circle cx="250" cy="120" r="4" />
          </g>
        </svg>
        <p class="serif" style="font-size: 1.3rem; color: var(--rose-bright);">Jasser &amp; Amani &mdash; Aligned Under Every Sky</p>

        <div class="coupons-grid">
          <div class="coupon">
            <h4>Late-Night Drive &amp; Playlist</h4>
            <p>You control the aux, the route, and the snacks. No questions asked.</p>
            <button onclick="claimCoupon(this)">Claim Voucher</button>
          </div>
          <div class="coupon">
            <h4>Sweetest Treat Delivery</h4>
            <p>Your favorite dessert or coffee brought straight to you whenever you crave it.</p>
            <button onclick="claimCoupon(this)">Claim Voucher</button>
          </div>
          <div class="coupon">
            <h4>Uninterrupted Date Night</h4>
            <p>Phones on silent, dressed up or cozy, all my attention 100% yours.</p>
            <button onclick="claimCoupon(this)">Claim Voucher</button>
          </div>
        </div>
      </div>
    </section>

    <!-- CHAPTER 5: FINALE -->
    <section id="chapter5">
      <div class="finale-box">
        <span class="chapter-tag">Chapter V &bull; Always Yours</span>
        <h2 class="section-title">You Are My Favorite Story, Amani</h2>
        <p class="section-sub" style="margin-bottom: 28px;">
          Thank you for being you. Tap below to send a burst of rose-gold hearts straight back to Jasser.
        </p>
        <button class="btn-primary" id="sendLoveBtn">Send Love Back &hearts;</button>
        <div class="love-counter" id="loveCounter"></div>
      </div>
    </section>

    <footer>
      Handcrafted with love by Jasser &bull; Exclusively for Amani
    </footer>
  </main>

  <script>
    /* 1. AMBIENT STARLIGHT & FLOATING PETALS CANVAS */
    const canvas = document.getElementById('ambientCanvas');
    const ctx = canvas.getContext('2d');
    let width, height, particles = [], burstHearts = [];

    function resizeCanvas() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    class Particle {
      constructor() {
        this.reset(true);
      }
      reset(initial = false) {
        this.x = Math.random() * width;
        this.y = initial ? Math.random() * height : -15;
        this.isPetal = Math.random() > 0.65;
        this.size = this.isPetal ? Math.random() * 5 + 4 : Math.random() * 2 + 0.6;
        this.speedY = this.isPetal ? Math.random() * 0.7 + 0.35 : Math.random() * 0.25 + 0.08;
        this.speedX = (Math.random() - 0.5) * 0.45;
        this.alpha = Math.random() * 0.65 + 0.2;
        this.angle = Math.random() * Math.PI * 2;
        this.spin = (Math.random() - 0.5) * 0.03;
      }
      update() {
        this.y += this.speedY;
        this.x += this.speedX + Math.sin(this.angle) * 0.25;
        this.angle += this.spin;
        if (this.y > height + 20) this.reset();
      }
      draw() {
        ctx.save();
        ctx.globalAlpha = this.alpha;
        if (this.isPetal) {
          ctx.translate(this.x, this.y);
          ctx.rotate(this.angle);
          ctx.fillStyle = '#e8b4b8';
          ctx.beginPath();
          ctx.ellipse(0, 0, this.size, this.size * 0.55, 0, 0, Math.PI * 2);
          
